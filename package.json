{
  "name": "co2-runner",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "@playwright/test": "^1.45",
    "hono": "^4",
    "playwright": "^1.45",
    "yaml": "^2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25",
    "tsx": "^4",
    "typescript": "^5"
  },
  "scripts": {
    "dev": "tsx watch main.ts serve",
    "serve": "tsx main.ts serve",
    "install-browsers": "tsx main.ts install",
    "run": "tsx main.ts run journeys/example.yaml",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 --test-force-exit tests/integration/*.ts tests/runner/*.ts tests/ui/*.ts tests/util/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt"
  }
}
